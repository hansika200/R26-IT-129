# ============================================================
# Hansika Teacher Dashboard — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# Database
DATABASE_PATH=./database/slsl_teacher.db

# ML Integration — points to existing Janith pipeline
JANITH_MODELS_DIR=../Janith/models
JANITH_TRAINING_DIR=../Janith/training
JANITH_MODEL_PATH=../Janith/models/slsl_model.tflite
JANITH_CLASSES_PATH=../Janith/models/classes.npy

# Storage directories
TEACHER_RECORDINGS_DIR=./storage/teacher_recordings
STUDENT_RECORDINGS_DIR=./storage/student_recordings
APPROVED_SIGNS_DIR=./storage/approved_signs
REJECTED_SIGNS_DIR=./storage/rejected_signs
ANNOTATIONS_DIR=./storage/annotations
UPLOADS_DIR=./uploads

# Retraining thresholds
MIN_SAMPLES_FOR_RETRAIN=30
MIN_NEW_SIGNS_FOR_RETRAIN=5

# Cross-origin
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# Existing Janith server URL (for bridging)
JANITH_SERVER_URL=http://127.0.0.1:5000
